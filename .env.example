HOST=127.0.0.1
PORT=3000

# Use your local MongoDB address or your Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_career_agent

# Use the exact origin the browser opens. Production uses HTTPS.
APP_ORIGIN=http://127.0.0.1:3000
# Generate your own key before startup. See README.md.
# JWT_SIGNING_KEY=

# Optional Google OAuth web client credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# Set only for a known reverse proxy topology. See README.md.
# TRUST_PROXY_HOPS=1

# Optional Alibaba Cloud Model Studio settings for roadmap generation.
# QWEN_API_KEY=
# QWEN_BASE_URL=https://your-model-studio-workspace.example/compatible-mode/v1
# QWEN_MODEL=
# QWEN_TIMEOUT_MS=20000
# QWEN_ENABLE_THINKING=false

# Groq uses its fixed HTTPS API endpoint and supports JSON Object Mode.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_TIMEOUT_MS=20000

# Single verified Gmail account authorized to access /admin.
# ARCSHIFT_ADMIN_EMAIL=
