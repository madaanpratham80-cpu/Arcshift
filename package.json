{
  "name": "arcshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch api/server.ts",
    "build": "npm run build:api && npm run build:web",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build:api && node --test test/*.test.js",
    "test:mongodb": "npm run build:api && node --test test/mongodb.integration.js",
    "test:auth": "npm run build:api && node --test test/auth.integration.js",
    "test:profile": "npm run build:api && node --test test/profile.integration.js",
    "test:roadmap": "npm run build:api && node --test test/roadmap.integration.js",
    "test:coaching": "npm run build:api && node --test test/coaching.integration.js",
    "test:revision": "npm run build:api && node --test test/revision.integration.js",
    "check:backend": "npm test && node --test --test-concurrency=1 test/*.integration.js",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json && vite build web",
    "dev:web": "vite web",
    "test:web": "npm run build && node --test test/*.e2e.js",
    "db:local": "node scripts/start-local-mongo.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.2",
    "bcrypt": "6.0.0",
    "cookie": "1.1.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "jose": "6.2.18",
    "lucide-react": "1.77.0",
    "mongodb": "7.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
