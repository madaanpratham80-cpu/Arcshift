# Exclude the api/ directory from Vercel function scanning.
# The only Vercel function entrypoint is index.js at the project root.
api/

# Local development files and secrets
.env
.env.*
.local/

# Local MongoDB data
.local/

# Build artifacts that are regenerated by build:vercel
dist/
public/

# Documentation and reference files
docs/references/
AI_Career_Agent_*.pdf
CASEY_Public_*.pdf

# Graph analysis output
graphify-out/

# OpenSpec planning files
openspec/

# Test suite
test/

# Scripts only needed during CI
scripts/

# Source files (backend compiled to dist/, web compiled to public/)
backend/
web/
